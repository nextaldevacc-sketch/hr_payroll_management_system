# ==============================================================================
# Nextal HR & Payroll Platform - Environment Configuration Template
# ==============================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nextal_hr_payroll
POSTGRES_PORT=5432

# Prisma Connection URL for API
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nextal_hr_payroll?schema=public

# API Service
API_PORT=5000
NODE_ENV=development
JWT_SECRET=nextal-secure-jwt-signing-secret-key-32-chars-min!

# Web Application
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000
