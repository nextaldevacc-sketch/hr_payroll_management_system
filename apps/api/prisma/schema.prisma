  company_id          String               @db.Uuid
  pay_run_id          String               @db.Uuid
  employee_id         String               @db.Uuid
  contract_id         String               @db.Uuid
  period_from         DateTime             @db.Date
  period_to           DateTime             @db.Date
  paid_days           Decimal              @db.Decimal(5, 2)
  worked_days         Decimal              @db.Decimal(5, 2)
  basic               Decimal              @db.Decimal(14, 2)
  gross               Decimal              @db.Decimal(14, 2)
  total_deductions    Decimal              @db.Decimal(14, 2)
  net                 Decimal              @db.Decimal(14, 2)
  previous_net        Decimal?             @db.Decimal(14, 2)
  variance_pct        Decimal?             @db.Decimal(6, 2)
  variance_reason     String?              @db.Text
  status              String               @default("Draft") @db.VarChar(20)
  is_final_settlement Boolean              @default(false)
  corrects_payslip_id String?              @db.Uuid
  pdf_url             String?              @db.Text
  created_at          DateTime             @default(now()) @db.Timestamptz
  created_by          String?              @db.Uuid
  updated_at          DateTime             @updatedAt @db.Timestamptz
  updated_by          String?              @db.Uuid

  company             companies            @relation(fields: [company_id], references: [id], onDelete: Restrict)
  pay_run             pay_runs             @relation(fields: [pay_run_id], references: [id], onDelete: Restrict)
  employee            employees            @relation(fields: [employee_id], references: [id], onDelete: Restrict)
  contract            contracts            @relation(fields: [contract_id], references: [id], onDelete: Restrict)
  corrects_payslip    payslips?            @relation("PayslipCorrection", fields: [corrects_payslip_id], references: [id], onDelete: Restrict)
  corrected_by        payslips[]           @relation("PayslipCorrection")
  lines               payslip_lines[]
  salary_adjustments  salary_adjustments[] @relation("CorrectedByAdjustment")
  final_settlements   final_settlements[]

  @@unique([pay_run_id, employee_id])
  @@index([company_id])
  @@index([pay_run_id])
  @@index([employee_id])
}

model payslip_lines {
  id             String        @id @default(uuid()) @db.Uuid
  company_id     String        @db.Uuid
  payslip_id     String        @db.Uuid
  salary_rule_id String        @db.Uuid
  code           String        @db.VarChar(20)
  name           String        @db.VarChar(100)
  quantity       Decimal?      @db.Decimal(8, 2)
  rate           Decimal?      @db.Decimal(9, 4)
  amount         Decimal       @db.Decimal(14, 2)
  source_type    String?       @db.VarChar(20)
  source_id      String?       @db.Uuid
  created_at     DateTime      @default(now()) @db.Timestamptz
  created_by     String?       @db.Uuid
  updated_at     DateTime      @updatedAt @db.Timestamptz
  updated_by     String?       @db.Uuid

  company        companies     @relation(fields: [company_id], references: [id], onDelete: Restrict)
  payslip        payslips      @relation(fields: [payslip_id], references: [id], onDelete: Restrict)
  salary_rule    salary_rules  @relation(fields: [salary_rule_id], references: [id], onDelete: Restrict)

  @@index([company_id])
  @@index([payslip_id])
  @@index([salary_rule_id])
}

model salary_adjustments {
  id                  String             @id @default(uuid()) @db.Uuid
  company_id          String             @db.Uuid
  employee_id         String             @db.Uuid
  type                String             @db.VarChar(30)
  total_amount        Decimal            @db.Decimal(14, 2)
  monthly_amount      Decimal            @db.Decimal(14, 2)
  start_month         DateTime           @db.Date
  balance             Decimal            @db.Decimal(14, 2)
  reason              String?            @db.Text
  corrects_payslip_id String?            @db.Uuid
  status              String             @default("Pending") @db.VarChar(20)
  approval_request_id String?            @db.Uuid
  created_at          DateTime           @default(now()) @db.Timestamptz
  created_by          String?            @db.Uuid
  updated_at          DateTime           @updatedAt @db.Timestamptz
  updated_by          String?            @db.Uuid

  company             companies          @relation(fields: [company_id], references: [id], onDelete: Restrict)
  employee            employees          @relation(fields: [employee_id], references: [id], onDelete: Restrict)
  corrects_payslip    payslips?          @relation("CorrectedByAdjustment", fields: [corrects_payslip_id], references: [id], onDelete: Restrict)
  approval_request    approval_requests? @relation(fields: [approval_request_id], references: [id], onDelete: Restrict)

  @@index([company_id])
  @@index([employee_id])
}

// ==========================================
// A.9 Offboarding (4 Tables)
// ==========================================

model separations {
  id                    String              @id @default(uuid()) @db.Uuid
  company_id            String              @db.Uuid
  employee_id           String              @db.Uuid
  type                  String              @db.VarChar(20)
  reason                String?             @db.Text
  notice_date           DateTime            @db.Date
  last_working_day      DateTime            @db.Date
  notice_shortfall_days Int                 @default(0) @db.SmallInt
  status                String              @default("Pending") @db.VarChar(20)
  approval_request_id   String?             @db.Uuid
  access_deactivated_at DateTime?           @db.Timestamptz
  created_at            DateTime            @default(now()) @db.Timestamptz
  created_by            String?             @db.Uuid
  updated_at            DateTime            @updatedAt @db.Timestamptz
  updated_by            String?             @db.Uuid

  company               companies           @relation(fields: [company_id], references: [id], onDelete: Restrict)
  employee              employees           @relation(fields: [employee_id], references: [id], onDelete: Restrict)
  approval_request      approval_requests?  @relation(fields: [approval_request_id], references: [id], onDelete: Restrict)
  clearance_items       clearance_items[]
  final_settlement      final_settlements?
  tasks                 separation_tasks[]

  @@index([company_id])
  @@index([employee_id])
}

model clearance_items {
  id             String      @id @default(uuid()) @db.Uuid
  company_id     String      @db.Uuid
  separation_id  String      @db.Uuid
  department_id  String      @db.Uuid
  owner_user_id  String      @db.Uuid
  item           String      @db.VarChar(100)
  status         String      @default("Pending") @db.VarChar(20)
  amount_due     Decimal     @default(0) @db.Decimal(14, 2)
  cleared_by     String?     @db.Uuid
  cleared_at     DateTime?   @db.Timestamptz
  note           String?     @db.Text
  created_at     DateTime    @default(now()) @db.Timestamptz
  created_by     String?     @db.Uuid
  updated_at     DateTime    @updatedAt @db.Timestamptz
  updated_by     String?     @db.Uuid

  company        companies   @relation(fields: [company_id], references: [id], onDelete: Restrict)
  separation     separations @relation(fields: [separation_id], references: [id], onDelete: Restrict)
  department     departments @relation(fields: [department_id], references: [id], onDelete: Restrict)
  owner_user     users       @relation("ClearanceItemOwner", fields: [owner_user_id], references: [id], onDelete: Restrict)
  clearer        users?      @relation("ClearanceItemClearedBy", fields: [cleared_by], references: [id], onDelete: Restrict)

  @@index([company_id])
  @@index([separation_id])
  @@index([department_id])
}

model final_settlements {
  id                    String             @id @default(uuid()) @db.Uuid
  company_id            String             @db.Uuid
  separation_id         String             @unique @db.Uuid
  salary_due            Decimal            @db.Decimal(14, 2)
  gratuity              Decimal            @db.Decimal(14, 2)
  leave_encashment_days Decimal            @db.Decimal(5, 2)
  leave_encashment      Decimal            @db.Decimal(14, 2)
  notice_recovery       Decimal            @default(0) @db.Decimal(14, 2)
  loan_recovery         Decimal            @default(0) @db.Decimal(14, 2)
  training_recovery     Decimal            @default(0) @db.Decimal(14, 2)
  clearance_recovery    Decimal            @default(0) @db.Decimal(14, 2)
  other_recovery        Decimal            @default(0) @db.Decimal(14, 2)
  net_payable           Decimal            @db.Decimal(14, 2)
  snapshot              Json?              @db.JsonB
  payslip_id            String?            @db.Uuid
  status                String             @default("Draft") @db.VarChar(20)
  approval_request_id   String?            @db.Uuid
  created_at            DateTime           @default(now()) @db.Timestamptz
  created_by            String?            @db.Uuid
  updated_at            DateTime           @updatedAt @db.Timestamptz
  updated_by            String?            @db.Uuid

  company               companies          @relation(fields: [company_id], references: [id], onDelete: Restrict)
  separation            separations        @relation(fields: [separation_id], references: [id], onDelete: Restrict)
  payslip               payslips?          @relation(fields: [payslip_id], references: [id], onDelete: Restrict)
  approval_request      approval_requests? @relation(fields: [approval_request_id], references: [id], onDelete: Restrict)

  @@index([company_id])
  @@index([separation_id])
}

model separation_tasks {
  id            String      @id @default(uuid()) @db.Uuid
  company_id    String      @db.Uuid
  separation_id String      @db.Uuid
  task_type     String      @db.VarChar(30)
  assigned_to   String      @db.Uuid
  due_date      DateTime    @db.Date
  status        String      @default("Open") @db.VarChar(20)
  completed_at  DateTime?   @db.Timestamptz
  created_at    DateTime    @default(now()) @db.Timestamptz
  created_by    String?     @db.Uuid
  updated_at    DateTime    @updatedAt @db.Timestamptz
  updated_by    String?     @db.Uuid

  company       companies   @relation(fields: [company_id], references: [id], onDelete: Restrict)
  separation    separations @relation(fields: [separation_id], references: [id], onDelete: Restrict)
  assignee      users       @relation("SeparationTaskAssignedTo", fields: [assigned_to], references: [id], onDelete: Restrict)

  @@index([company_id])
  @@index([separation_id])
  @@index([assigned_to])
}

model settings_versions {
  id             String    @id @default(uuid()) @db.Uuid
  company_id     String    @db.Uuid
  entity_type    String    @db.VarChar(50)
  entity_id      String    @db.Uuid
  version_no     Int       @db.SmallInt
  effective_from DateTime  @db.Date
  snapshot       Json      @db.JsonB
  created_at     DateTime  @default(now()) @db.Timestamptz
  created_by     String?   @db.Uuid

  company        companies @relation(fields: [company_id], references: [id], onDelete: Restrict)

  @@index([company_id])
  @@index([entity_type, entity_id])
  @@index([effective_from])
}

