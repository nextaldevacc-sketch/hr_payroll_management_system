datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// A.3 Organisation and Access (9 Tables)
// ==========================================

model companies {
  id                     String    @id @default(uuid()) @db.Uuid
  name                   String    @db.VarChar(200)
  name_ar                String?   @db.VarChar(200)
  trade_license_no       String    @unique @db.VarChar(50)
  logo_url               String?   @db.Text
  default_language       String    @default("en") @db.VarChar(2)
  status                 String    @default("Active") @db.VarChar(20)
  default_cutoff_day         Int       @default(25) @db.SmallInt
  variance_threshold_pct     Decimal   @default(5.00) @db.Decimal(5, 2)
  variance_threshold_aed     Decimal   @default(500.00) @db.Decimal(14, 2)
  alert_days                 Int[]
  document_digest_recipients String[]
  document_type_settings     Json?     @db.JsonB
  absence_divisor            String    @default("DIV_30") @db.VarChar(20)
  ot_multiplier_normal       Decimal   @default(1.2500) @db.Decimal(5, 4)
  ot_multiplier_night        Decimal   @default(1.5000) @db.Decimal(5, 4)
  ot_multiplier_rest         Decimal   @default(1.5000) @db.Decimal(5, 4)
  ot_multiplier_holiday      Decimal   @default(1.5000) @db.Decimal(5, 4)
  night_window_start         String    @default("22:00:00") @db.VarChar(8)
  night_window_end           String    @default("04:00:00") @db.VarChar(8)
  gpssa_employee_rate        Decimal   @default(5.00) @db.Decimal(5, 2)
  gpssa_employer_rate        Decimal   @default(12.50) @db.Decimal(5, 2)
  gpssa_max_salary           Decimal   @default(50000.00) @db.Decimal(14, 2)
  created_at                 DateTime  @default(now()) @db.Timestamptz
  created_by             String?   @db.Uuid
  updated_at             DateTime  @updatedAt @db.Timestamptz
  updated_by             String?   @db.Uuid

  company_visas          company_visas[]
  branches               branches[]
  departments            departments[]
  jobs                   jobs[]
  users                  users[]
  user_roles             user_roles[]
  support_access_grants  support_access_grants[]
  approval_flows         approval_flows[]
  approval_flow_steps    approval_flow_steps[]
  approval_requests      approval_requests[]
  approval_actions       approval_actions[]
  audit_logs             audit_logs[]
  employees              employees[]
  contracts              contracts[]
  employee_documents     employee_documents[]
  bank_accounts          bank_accounts[]
  shifts                 shifts[]
  attendance_policies    attendance_policies[]
  penalty_steps          penalty_steps[]
  device_mappings        device_mappings[]
  biometric_imports      biometric_imports[]
  punches                punches[]
  attendance_days        attendance_days[]
  attendance_requests    attendance_requests[]
  overtime_requests      overtime_requests[]
  public_holidays        public_holidays[]
  leave_types            leave_types[]
  accrual_plans          accrual_plans[]
  leave_allocations      leave_allocations[]
  leave_requests         leave_requests[]
  salary_structures      salary_structures[]
  salary_rules           salary_rules[]
  pay_runs               pay_runs[]
  pay_run_issues         pay_run_issues[]
  payslips               payslips[]
  payslip_lines          payslip_lines[]
  salary_adjustments     salary_adjustments[]
  separations            separations[]
  clearance_items        clearance_items[]
  final_settlements      final_settlements[]
  separation_tasks       separation_tasks[]
  settings_versions      settings_versions[]
}

model company_visas {
  id                   String      @id @default(uuid()) @db.Uuid
  company_id           String      @db.Uuid
  name                 String      @db.VarChar(200)
  mol_establishment_id String      @unique @db.VarChar(20)
  bank_routing_code    String      @db.VarChar(9)
  emirate              String      @db.VarChar(30)
  created_at           DateTime    @default(now()) @db.Timestamptz
  created_by           String?     @db.Uuid
  updated_at           DateTime    @updatedAt @db.Timestamptz
  updated_by           String?     @db.Uuid

  company              companies   @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branches             branches[]
  employees            employees[]
  pay_runs             pay_runs[]

  @@index([company_id])
}

model branches {
  id              String            @id @default(uuid()) @db.Uuid
  company_id      String            @db.Uuid
  company_visa_id String            @db.Uuid
  name            String            @db.VarChar(200)
  name_ar         String?           @db.VarChar(200)
  emirate         String            @db.VarChar(30)
  created_at      DateTime          @default(now()) @db.Timestamptz
  created_by      String?           @db.Uuid
  updated_at      DateTime          @updatedAt @db.Timestamptz
  updated_by      String?           @db.Uuid

  company         companies         @relation(fields: [company_id], references: [id], onDelete: Restrict)
  company_visa    company_visas     @relation(fields: [company_visa_id], references: [id], onDelete: Restrict)
  employees       employees[]
  public_holidays public_holidays[]

  @@index([company_id])
  @@index([company_visa_id])
}

model departments {
  id              String            @id @default(uuid()) @db.Uuid
  company_id      String            @db.Uuid
  parent_id       String?           @db.Uuid
  name            String            @db.VarChar(200)
  name_ar         String?           @db.VarChar(200)
  manager_id      String?           @db.Uuid
  cost_centre     String?           @db.VarChar(20)
  created_at      DateTime          @default(now()) @db.Timestamptz
  created_by      String?           @db.Uuid
  updated_at      DateTime          @updatedAt @db.Timestamptz
  updated_by      String?           @db.Uuid

  company         companies         @relation(fields: [company_id], references: [id], onDelete: Restrict)
  parent          departments?      @relation("DepartmentHierarchy", fields: [parent_id], references: [id], onDelete: Restrict)
  children        departments[]     @relation("DepartmentHierarchy")
  manager         employees?        @relation("DepartmentManager", fields: [manager_id], references: [id], onDelete: Restrict)
  jobs            jobs[]
  contracts       contracts[]
  clearance_items clearance_items[]

  @@index([company_id])
  @@index([parent_id])
  @@index([manager_id])
}

model jobs {
  id            String      @id @default(uuid()) @db.Uuid
  company_id    String      @db.Uuid
  department_id String      @db.Uuid
  title         String      @db.VarChar(200)
  title_ar      String?     @db.VarChar(200)
  job_code      String?     @db.VarChar(30)
  grade         String?     @db.VarChar(20)
  created_at    DateTime    @default(now()) @db.Timestamptz
  created_by    String?     @db.Uuid
  updated_at    DateTime    @updatedAt @db.Timestamptz
  updated_by    String?     @db.Uuid

  company       companies   @relation(fields: [company_id], references: [id], onDelete: Restrict)
  department    departments @relation(fields: [department_id], references: [id], onDelete: Restrict)
  contracts     contracts[]

  @@index([company_id])
  @@index([department_id])
}

model users {
  id                      String                  @id @default(uuid()) @db.Uuid
  company_id              String?                 @db.Uuid
  employee_id             String?                 @unique @db.Uuid
  email                   String                  @unique @db.VarChar(255)
  password_hash           String                  @db.VarChar(255)
  is_platform_admin       Boolean                 @default(false)
  status                  String                  @default("Active") @db.VarChar(20)
  failed_logins           Int                     @default(0) @db.SmallInt
  locked_until            DateTime?               @db.Timestamptz
  token_version           Int                     @default(1)
  last_login_at           DateTime?               @db.Timestamptz
  deactivated_at          DateTime?               @db.Timestamptz
  created_at              DateTime                @default(now()) @db.Timestamptz
  created_by              String?                 @db.Uuid
  updated_at              DateTime                @updatedAt @db.Timestamptz
  updated_by              String?                 @db.Uuid

  company                 companies?              @relation(fields: [company_id], references: [id], onDelete: Restrict)
  employee                employees?              @relation(fields: [employee_id], references: [id], onDelete: Restrict)
  user_roles              user_roles[]
  auth_tokens             auth_tokens[]
  platform_grants         support_access_grants[] @relation("PlatformUser")
  granted_by_user         support_access_grants[] @relation("GrantedByUser")
  requested_approvals     approval_requests[]     @relation("ApprovalRequestedBy")
  acted_approvals         approval_actions[]      @relation("ApprovalActedBy")
  audit_logs              audit_logs[]
  verified_employees      employees[]             @relation("EmployeeVerifiedBy")
  owner_documents         employee_documents[]    @relation("DocumentOwner")
  uploaded_documents      employee_documents[]    @relation("DocumentUploadedBy")
  verified_documents      employee_documents[]    @relation("DocumentVerifiedBy")
  biometric_imports       biometric_imports[]     @relation("BiometricImportedBy")
  manager_attendance_days attendance_days[]       @relation("ManagerConfirmedBy")
  hr_attendance_days      attendance_days[]       @relation("HrConfirmedBy")
  validated_pay_runs      pay_runs[]              @relation("PayRunValidatedBy")
  locked_pay_runs         pay_runs[]              @relation("PayRunLockedBy")
  owner_clearance_items   clearance_items[]       @relation("ClearanceItemOwner")
  cleared_items           clearance_items[]       @relation("ClearanceItemClearedBy")
  assigned_separation_tasks separation_tasks[]    @relation("SeparationTaskAssignedTo")

  @@index([company_id])
}

model auth_tokens {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(64)
  purpose    String    @db.VarChar(30)
  expires_at DateTime  @db.Timestamptz
  used_at    DateTime? @db.Timestamptz
  created_at DateTime  @default(now()) @db.Timestamptz

  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token_hash])
}

model roles {
  id                  String                @id @default(uuid()) @db.Uuid
  code                String                @unique @db.VarChar(30)
  name                String                @db.VarChar(100)
  sees_salary         Boolean               @default(false)
  permissions         Json?                 @db.JsonB
  created_at          DateTime              @default(now()) @db.Timestamptz
  created_by          String?               @db.Uuid
  updated_at          DateTime              @updatedAt @db.Timestamptz
  updated_by          String?               @db.Uuid

  user_roles          user_roles[]
  approval_flow_steps approval_flow_steps[]
}

model user_roles {
  id         String    @id @default(uuid()) @db.Uuid
  company_id String    @db.Uuid
  user_id    String    @db.Uuid
  role_id    String    @db.Uuid
  scope_type String    @default("Company") @db.VarChar(20)
  scope_id   String?   @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamptz
  created_by String?   @db.Uuid
  updated_at DateTime  @updatedAt @db.Timestamptz
  updated_by String?   @db.Uuid

  company    companies @relation(fields: [company_id], references: [id], onDelete: Restrict)
  user       users     @relation(fields: [user_id], references: [id], onDelete: Restrict)
  role       roles     @relation(fields: [role_id], references: [id], onDelete: Restrict)

  @@index([company_id])
  @@index([user_id])
  @@index([role_id])
}

model support_access_grants {
  id               String    @id @default(uuid()) @db.Uuid
  company_id       String    @db.Uuid
  platform_user_id String    @db.Uuid
  granted_by       String    @db.Uuid
  reason           String    @db.Text
  starts_at        DateTime  @db.Timestamptz
  ends_at          DateTime  @db.Timestamptz
  revoked_at       DateTime? @db.Timestamptz
  created_at       DateTime  @default(now()) @db.Timestamptz
  created_by       String?   @db.Uuid
  updated_at       DateTime  @updatedAt @db.Timestamptz
  updated_by       String?   @db.Uuid

  company          companies @relation(fields: [company_id], references: [id], onDelete: Restrict)
  platform_user    users     @relation("PlatformUser", fields: [platform_user_id], references: [id], onDelete: Restrict)
  grantor          users     @relation("GrantedByUser", fields: [granted_by], references: [id], onDelete: Restrict)

  @@index([company_id])
  @@index([platform_user_id])
  @@index([granted_by])
}

// ==========================================
// A.4 Approvals and Audit (5 Tables)
// ==========================================

model approval_flows {
  id                  String                @id @default(uuid()) @db.Uuid
  company_id          String                @db.Uuid
  request_type        String                @db.VarChar(30)
  name                String                @db.VarChar(100)
  condition           Json?                 @db.JsonB
  priority            Int                   @default(1) @db.SmallInt
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now()) @db.Timestamptz
  created_by          String?               @db.Uuid
  updated_at          DateTime              @updatedAt @db.Timestamptz
  updated_by          String?               @db.Uuid

  company             companies             @relation(fields: [company_id], references: [id], onDelete: Restrict)
  steps               approval_flow_steps[]
  requests            approval_requests[]

  @@index([company_id])
}

model approval_flow_steps {
  id            String         @id @default(uuid()) @db.Uuid
  company_id    String         @db.Uuid
  flow_id       String         @db.Uuid
  step_no            Int            @db.SmallInt
  role_id            String         @db.Uuid
  approver_rule      String         @db.VarChar(30)
  is_conditional     Boolean        @default(false)
  condition_field    String?        @db.VarChar(50)
  condition_operator String?        @db.VarChar(10)
  condition_value    Decimal?       @db.Decimal(10, 2)
  created_at         DateTime       @default(now()) @db.Timestamptz
  created_by    String?        @db.Uuid
  updated_at    DateTime       @updatedAt @db.Timestamptz
  updated_by    String?        @db.Uuid

  company       companies      @relation(fields: [company_id], references: [id], onDelete: Restrict)
  flow          approval_flows @relation(fields: [flow_id], references: [id], onDelete: Restrict)
  role          roles          @relation(fields: [role_id], references: [id], onDelete: Restrict)

  @@index([company_id])
  @@index([flow_id])
  @@index([role_id])
}

model approval_requests {
  id                  String                @id @default(uuid()) @db.Uuid
  company_id          String                @db.Uuid
  flow_id             String                @db.Uuid
  request_type        String                @db.VarChar(30)
  record_id           String                @db.Uuid
  current_step        Int                   @default(1) @db.SmallInt
  status              String                @default("Pending") @db.VarChar(20)
  requested_by        String                @db.Uuid
  requested_at        DateTime              @default(now()) @db.Timestamptz
  completed_at        DateTime?             @db.Timestamptz
  created_at          DateTime              @default(now()) @db.Timestamptz
  created_by          String?               @db.Uuid
  updated_at          DateTime              @updatedAt @db.Timestamptz
  updated_by          String?               @db.Uuid

  company             companies             @relation(fields: [company_id], references: [id], onDelete: Restrict)
  flow                approval_flows        @relation(fields: [flow_id], references: [id], onDelete: Restrict)
  requester           users                 @relation("ApprovalRequestedBy", fields: [requested_by], references: [id], onDelete: Restrict)
  actions             approval_actions[]
  contracts           contracts[]
  attendance_requests attendance_requests[]
  overtime_requests   overtime_requests[]
  leave_requests      leave_requests[]
  salary_adjustments  salary_adjustments[]
  pay_runs            pay_runs[]
  separations         separations[]
  final_settlements   final_settlements[]

  @@index([company_id])
  @@index([flow_id])
  @@index([requested_by])
  @@index([record_id])
}

model approval_actions {
  id                  String            @id @default(uuid()) @db.Uuid
  company_id          String            @db.Uuid
  approval_request_id String            @db.Uuid
  step_no             Int               @db.SmallInt
  acted_by            String            @db.Uuid
  action              String            @db.VarChar(20)
  comment             String?           @db.Text
  acted_at            DateTime          @default(now()) @db.Timestamptz
  created_at          DateTime          @default(now()) @db.Timestamptz
  created_by          String?           @db.Uuid
  updated_at          DateTime          @updatedAt @db.Timestamptz
  updated_by          String?           @db.Uuid

  company             companies         @relation(fields: [company_id], references: [id], onDelete: Restrict)
  request             approval_requests @relation(fields: [approval_request_id], references: [id], onDelete: Restrict)
  actor               users             @relation("ApprovalActedBy", fields: [acted_by], references: [id], onDelete: Restrict)

  @@index([company_id])
  @@index([approval_request_id])
  @@index([acted_by])
}

model audit_logs {
  id         BigInt    @id @default(autoincrement())
  company_id String    @db.Uuid
  user_id    String?   @db.Uuid
  action     String    @db.VarChar(20)
  table_name String    @db.VarChar(60)
  record_id  String    @db.Uuid
  old_values Json?     @db.JsonB
  new_values Json?     @db.JsonB
  ip_address String?   @db.VarChar(45)
  created_at DateTime  @default(now()) @db.Timestamptz

  company    companies @relation(fields: [company_id], references: [id], onDelete: Restrict)
  user       users?    @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([company_id])
  @@index([user_id])
  @@index([table_name])
  @@index([record_id])
}

// ==========================================
// A.5 Employees (4 Tables)
// ==========================================

model employees {
  id                     String                @id @default(uuid()) @db.Uuid
  company_id             String                @db.Uuid
  employee_code          String                @db.VarChar(20)
  name                   String                @db.VarChar(200)
  arabic_name            String?               @db.VarChar(200)
  legal_name             String?               @db.VarChar(200)
  status                 String                @default("Active") @db.VarChar(20)
  joining_date           DateTime              @db.Date
  residency_type         String                @default("Expat") @db.VarChar(20)
  nationality            String                @db.VarChar(60)
  gender                 String                @db.VarChar(10)
  birth_date             DateTime?             @db.Date
  mohre_person_id        String?               @db.VarChar(14)
  company_visa_id        String                @db.Uuid
  branch_id              String                @db.Uuid
  manager_id             String?               @db.Uuid
  hr_manager_id          String?               @db.Uuid
  leave_approver_id      String?               @db.Uuid
  work_email             String?               @db.VarChar(255)
  mobile                 String?               @db.VarChar(20)
  emergency_contact_name String?               @db.VarChar(200)
  emergency_contact_phone String?              @db.VarChar(20)
  verified_by            String?               @db.Uuid
  verified_at            DateTime?             @db.Timestamptz
  activated_at           DateTime?             @db.Timestamptz
  created_at             DateTime              @default(now()) @db.Timestamptz
  created_by             String?               @db.Uuid
  updated_at             DateTime              @updatedAt @db.Timestamptz
  updated_by             String?               @db.Uuid

  company                companies             @relation(fields: [company_id], references: [id], onDelete: Restrict)
  company_visa           company_visas         @relation(fields: [company_visa_id], references: [id], onDelete: Restrict)
  branch                 branches              @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  manager                employees?            @relation("LineManager", fields: [manager_id], references: [id], onDelete: Restrict)
  subordinates           employees[]           @relation("LineManager")
  hr_manager             employees?            @relation("HrManager", fields: [hr_manager_id], references: [id], onDelete: Restrict)
  hr_managed_employees   employees[]           @relation("HrManager")
  leave_approver         employees?            @relation("LeaveApprover", fields: [leave_approver_id], references: [id], onDelete: Restrict)
  leave_approved_employees employees[]         @relation("LeaveApprover")
  verifier               users?                @relation("EmployeeVerifiedBy", fields: [verified_by], references: [id], onDelete: Restrict)
  managed_departments    departments[]         @relation("DepartmentManager")
  user                   users?
  contracts              contracts[]
  documents              employee_documents[]
  bank_accounts          bank_accounts[]
  device_mappings        device_mappings[]
  punches                punches[]
  attendance_days        attendance_days[]
  attendance_requests    attendance_requests[]
  overtime_requests      overtime_requests[]
  leave_allocations      leave_allocations[]
  leave_requests         leave_requests[]
  pay_run_issues         pay_run_issues[]
  payslips               payslips[]
  salary_adjustments     salary_adjustments[]
  separations            separations[]

  @@unique([company_id, employee_code])
  @@index([company_id])
  @@index([company_visa_id])
  @@index([branch_id])
}

model contracts {
  id                   String             @id @default(uuid()) @db.Uuid
  company_id           String             @db.Uuid
  employee_id          String             @db.Uuid
  version_no           Int                @default(1) @db.SmallInt
  effective_date       DateTime           @db.Date
  contract_type        String             @default("Limited") @db.VarChar(20)
  start_date           DateTime           @db.Date
  end_date             DateTime?          @db.Date
  probation_end        DateTime?          @db.Date
  job_id               String             @db.Uuid
  department_id        String             @db.Uuid
  shift_id             String             @db.Uuid
  attendance_policy_id String             @db.Uuid
  structure_id         String             @db.Uuid
  basic                Decimal            @db.Decimal(14, 2)
  housing              Decimal            @default(0) @db.Decimal(14, 2)
  transport            Decimal            @default(0) @db.Decimal(14, 2)
  other_allowances     Decimal            @default(0) @db.Decimal(14, 2)
  gross                Decimal            @db.Decimal(14, 2)
  annual_leave_days    Int                @default(30) @db.SmallInt
  gratuity_rule        String             @default("UAE_LABOUR_LAW") @db.VarChar(30)
  notice_days_employee Int                @default(30) @db.SmallInt
  notice_days_employer Int                @default(30) @db.SmallInt
  training_cost        Decimal?           @db.Decimal(14, 2)
  status               String             @default("Draft") @db.VarChar(20)
  approval_request_id  String?            @db.Uuid
  created_at           DateTime           @default(now()) @db.Timestamptz
  created_by           String?            @db.Uuid
  updated_at           DateTime           @updatedAt @db.Timestamptz
  updated_by           String?            @db.Uuid

  company              companies          @relation(fields: [company_id], references: [id], onDelete: Restrict)
  employee             employees          @relation(fields: [employee_id], references: [id], onDelete: Restrict)
  job                  jobs               @relation(fields: [job_id], references: [id], onDelete: Restrict)
  department           departments        @relation(fields: [department_id], references: [id], onDelete: Restrict)
  shift                shifts             @relation(fields: [shift_id], references: [id], onDelete: Restrict)
  attendance_policy    attendance_policies @relation(fields: [attendance_policy_id], references: [id], onDelete: Restrict)
  salary_structure     salary_structures  @relation(fields: [structure_id], references: [id], onDelete: Restrict)
  approval_request     approval_requests? @relation(fields: [approval_request_id], references: [id], onDelete: Restrict)
  payslips             payslips[]

  @@unique([employee_id, effective_date])
  @@index([company_id])
  @@index([employee_id])
}

model employee_documents {
  id                  String    @id @default(uuid()) @db.Uuid
  company_id          String    @db.Uuid
  employee_id         String    @db.Uuid
  doc_type            String    @db.VarChar(30)
  doc_number          String    @db.VarChar(50)
  issue_date          DateTime? @db.Date
  expiry_date         DateTime  @db.Date
  file_url            String?   @db.Text
  owner_id            String?   @db.Uuid
  status              String    @default("Valid") @db.VarChar(20)
  last_alert_days     Int?      @db.SmallInt
  last_alert_sent_at  DateTime? @db.Timestamptz
  verification_status String    @default("Verified") @db.VarChar(20)
  uploaded_by         String?   @db.Uuid
  verified_by         String?   @db.Uuid
  created_at          DateTime  @default(now()) @db.Timestamptz
  created_by          String?   @db.Uuid
  updated_at          DateTime  @updatedAt @db.Timestamptz
