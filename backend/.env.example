# Nextal API Environment Variables
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nextal_hr_payroll?schema=public
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/nextal_hr_test?schema=public
JWT_SECRET=nextal-secure-jwt-signing-secret-key-32-chars-min!
FEATURE_PLATFORM_ADMIN=false

# AES-256-GCM encryption key for sensitive employee documents (64 hex characters = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOCUMENT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
