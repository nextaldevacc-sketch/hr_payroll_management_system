# =============================================================================
# Nextal HR & Payroll Platform — Production Environment Configuration Template
# UAE Sovereign Cloud Deployment (AWS me-central-1 / Azure UAE North)
# =============================================================================

# Node Environment
NODE_ENV=production

# -----------------------------------------------------------------------------
# 1. Database (PostgreSQL 16)
# -----------------------------------------------------------------------------
POSTGRES_USER=nextal_admin
POSTGRES_PASSWORD=REPLACE_WITH_HIGH_ENTROPY_PASSWORD_32_CHARS_MIN
POSTGRES_DB=nextal_hr_production
DATABASE_URL=postgresql://nextal_admin:REPLACE_WITH_HIGH_ENTROPY_PASSWORD_32_CHARS_MIN@postgres:5432/nextal_hr_production?schema=public&sslmode=prefer

# -----------------------------------------------------------------------------
# 2. Cryptographic Security & Authentication
# -----------------------------------------------------------------------------
# Must be at least 32 characters of high-entropy random bytes.
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_STRONG_CRYPTOGRAPHIC_JWT_KEY_AT_LEAST_32_CHARACTERS_LONG!
JWT_EXPIRES_IN=24h

# AES-256-GCM encryption key for sensitive employee documents (64 hex characters = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOCUMENT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# -----------------------------------------------------------------------------
# 3. Application Networking & URLs
# -----------------------------------------------------------------------------
API_PORT=5000
WEB_PORT=3000
FRONTEND_PUBLIC_URL=https://app.nextal.ae
NEXT_PUBLIC_API_URL=https://api.nextal.ae
FEATURE_PLATFORM_ADMIN=false
NEXT_PUBLIC_FEATURE_PLATFORM_ADMIN=false

# -----------------------------------------------------------------------------
# 4. Storage & Sovereign Document Retention (UAE PDPL Compliant)
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/app/storage
# Optional AWS S3 (me-central-1 UAE Region)
# S3_BUCKET=nextal-uae-documents-prod
# S3_REGION=me-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# 5. SMTP / Corporate Mail Delivery
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=REPLACE_WITH_SMTP_PROVIDER_KEY
MAIL_FROM="Nextal HR Platform <notifications@nextal.ae>"

# -----------------------------------------------------------------------------
# 6. Disaster Recovery & Automated Backups
# -----------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_DIR=/backups

