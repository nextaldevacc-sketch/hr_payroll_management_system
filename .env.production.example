# ==============================================================================
# Nextal HR & Payroll — Production Environment Configuration (.env.production)
# ==============================================================================
# Generate secure production secrets using:
#   node scripts/gen-secrets.mjs
# Validate configuration prior to deployment using:
#   node scripts/preflight-prod.mjs .env.production
# ==============================================================================

# Node Environment
NODE_ENV=production

# Public Domain Name (for Caddy automated TLS and HTTPS)
# Example: payroll.yourcompany.ae
DOMAIN=payroll.example.ae

# PostgreSQL Production Credentials (Internal Docker network only)
POSTGRES_USER=nextal_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD_32_CHARS_MIN
POSTGRES_DB=nextal_hr_prod

# Database Connection URL (used by migration runners and backend)
DATABASE_URL=postgresql://nextal_app:CHANGE_ME_STRONG_DB_PASSWORD_32_CHARS_MIN@postgres:5432/nextal_hr_prod?schema=public

# Cryptographic Keys (MUST BE GENERATED VIA `node scripts/gen-secrets.mjs`)
# 64-character (32-byte) hex string for signing JWT authentication tokens
JWT_SECRET=REPLACE_WITH_GENERATED_64_CHAR_HEX_JWT_SECRET
# 64-character (32-byte) hex string for AES-256-GCM encryption of stored documents
DOCUMENT_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_64_CHAR_HEX_DOCUMENT_KEY

# Security & Reverse Proxy Settings
# Must exactly match the public HTTPS origin (no trailing slash, no wildcard)
ALLOWED_ORIGIN=https://payroll.example.ae
# Enforce HttpOnly; Secure; SameSite=Lax on all session cookies
COOKIE_SECURE=true
# Enable trust proxy (1) behind Caddy reverse proxy for rate-limiting and IP tracking
TRUST_PROXY=1

# Scheduled Background Automation (Nightly document expiry alerts & monthly leave accrual)
ENABLE_JOBS=true

# API & Swagger Documentation (Disabled by default in production)
ENABLE_API_DOCS=false

# Manual Background Job Trigger API (/api/v1/jobs/* - Disabled in production)
ENABLE_JOB_TRIGGER_API=false

# Document Storage Configuration
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/app/backend/storage

# Storage Cleanup Background Job Mode (Part 18 Safety Standard)
# Options: off | dry-run | delete
# Defaults to "dry-run" (scans and logs what WOULD be deleted, never unlinks anything).
# Recommend keeping "dry-run" for the first week in production, review audit logs/Docker logs,
# then switch to "delete" once confident.
STORAGE_CLEANUP_MODE=dry-run

# Automated Backup Encryption Passphrase
# Used by deploy/backup.sh and deploy/restore.sh to encrypt pg_dump and documents
BACKUP_ENCRYPTION_PASSPHRASE=REPLACE_WITH_GENERATED_STRONG_BACKUP_PASSPHRASE

# ------------------------------------------------------------------------------
# Email (REQUIRED in production unless MAIL_MODE=disabled)
# Invites, password resets and alerts are sent through this SMTP account.
# Set these directly on the server. Never commit real values.
# ------------------------------------------------------------------------------
MAIL_MODE=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# false for port 587 (STARTTLS), true for port 465
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM="Nextal HR & Payroll" <noreply@payroll.example.ae>
ALERT_EMAIL_RECIPIENT=ops@example.ae
